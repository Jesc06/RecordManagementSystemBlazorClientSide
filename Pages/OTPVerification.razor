@page "/OTPVerification"
@inject AuthService _authService
@layout AccountLayout;
@inject NavigationManager nav

<link rel="stylesheet" href="/css/OTP.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="container">
    <div style="text-align:center; margin-bottom: 10px;">
        <i class="fa-solid fa-shield-halved fa-2x" style="color:#ff9800; background:rgba(255,255,255,0.8); border-radius:50%; padding:10px; margin-right:8px; box-shadow:0 2px 8px rgba(44,62,80,0.10);"></i>
    </div>

    <h3>Two-Factor Authentication</h3>
    <InputNumber @bind-Value="verifyOtpDTO.OTP" placeholder="Enter OTP" class="otp-input" />     
    <button @onclick="Verify">Verify OTP</button>      
</div>


 @if(!string.IsNullOrEmpty(message))
    {
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation>
            <div class="modal-icon">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>
            <h4>Error</h4>
            <p>@message</p>
            <button class="close-btn" @onclick="CloseModal">
                <i class="fa-solid fa-xmark"></i> Dismiss
            </button>
        </div>
    </div>

    }

@code{
    VerifyOtpDTO verifyOtpDTO = new VerifyOtpDTO();
    private string sessionID;
    private string message;


    private void CloseModal()
    {
        message = string.Empty;
    }


    protected override void OnInitialized()
    {
        //get sessionId from query parameter
        var uri = new Uri(nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("sessionId", out var sid))
        {
            sessionID = sid;
        }
    }


    public async Task Verify(){
       var result = await _authService.VerifyOTP(new VerifyOtpDTO 
       {
        sessionId = sessionID,
        OTP = verifyOtpDTO.OTP
       });

       if(result)
       {
        nav.NavigateTo("/Tama");
       }
       else
       {
        message = "Invalid OTP. Please try again.";
       }
      
    }

}