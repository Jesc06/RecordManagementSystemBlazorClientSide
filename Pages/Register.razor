@page "/register"
@layout AccountLayout
@inject AuthService _authService
@inject NavigationManager nav

<link rel="stylesheet" href="/css/Register.css" />

@if (isLoading)
{
    <div class="loading-overlay">
        <div class="loading-content">
            <span class="spinner"></span>
            <span class="loading-text">Signing up...</span>
        </div>
    </div>
}

<div class="container">
    <div class="form-card">
        <h2>Create Student Account</h2>
        <p class="subtitle">Fill in the details to register</p>

        <div class="form-grid">
            <div class="input-group"><input type="text" placeholder="Firstname" @bind="@registerAccountDTO.FirstName"></div>
            <div class="input-group"><input type="text" placeholder="Middlename" @bind="@registerAccountDTO.Middlename"></div>
            <div class="input-group"><input type="text" placeholder="Lastname" @bind="@registerAccountDTO.LastName"></div>

            <div class="input-group">
                <select @bind="@registerAccountDTO.Gender">
                    <option value="">Gender</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>LGBTQ</option>
                </select>
            </div>

            <div class="input-group"><input type="number" min="1950" max="2025" placeholder="Year of Birth" @bind="@registerAccountDTO.YearOfBirth"></div>
            <div class="input-group">
                <select @bind="@registerAccountDTO.MonthOfBirth">
                    <option value="">Month of Birth</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="input-group"><input type="number" min="1" max="31" placeholder="Date of Birth" @bind="@registerAccountDTO.DateOfBirth"></div>

            <div class="input-group"><input type="number" placeholder="Mobile Number" @bind="@registerAccountDTO.MobileNumber"></div>
            <div class="input-group full-width"><input type="text" placeholder="Home Address" @bind="@registerAccountDTO.HomeAddress"></div>

            <div class="input-group">
                <select @bind="@registerAccountDTO.Program">
                    <option value="">Program</option>
                    <option>BSIT</option>
                    <option>BSED</option>
                    <option>BSTM</option>
                    <option>BSCPE</option>
                    <option>BSCRIM</option>
                </select>
            </div>

            <div class="input-group">
                <select @bind="@registerAccountDTO.YearLevel">
                    <option value="">Year Level</option>
                    <option value="1">First Year</option>
                    <option value="2">Second Year</option>
                    <option value="3">Third Year</option>
                    <option value="4">Fourth Year</option>
                </select>
            </div>

            <div class="input-group full-width"><input type="text" placeholder="Student ID" @bind="@registerAccountDTO.StudentID"></div>
            <div class="input-group full-width"><input type="email" placeholder="Email" @bind="@registerAccountDTO.Email"></div>
            <div class="input-group full-width"><input type="password" placeholder="Password" @bind="@registerAccountDTO.Password"></div>
        </div>

        <button class="btn-submit" @onclick="RegisterAcc" disabled="@isLoading">Sign up</button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="validation-message">@errorMessage</div>
        }

        <p class="subtitle2">Already have an account?</p>
        <a href="/">Sign in</a>
    </div>
</div>


@code {
    RegisterAccountDTO registerAccountDTO = new();
    bool isLoading;
    string errorMessage;

    public async Task RegisterAcc()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var result = await _authService.RegisterAccount(registerAccountDTO);
            nav.NavigateTo($"/OTPVerification?sessionId={result.sessionId}"); // pass sessionId to OTPVerification page
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to register. Please check your inputs or try again later.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }
}
